# ============================================
# DeadManPing - Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# PUBLIC variables (exposed to browser - safe for anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# PRIVATE variable (server-side ONLY - NEVER exposed to browser)
# WARNING: This key bypasses RLS and has full database access!
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Stripe Configuration
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (fallback - only used if Products with metadata not found in Stripe)
# Prices are automatically fetched from Stripe API if Products have metadata: plan_key = "starter" | "pro" | "team"
STRIPE_PRICE_ID_STARTER=price_xxxxx
STRIPE_PRICE_ID_PRO=price_xxxxx
STRIPE_PRICE_ID_TEAM=price_xxxxx

# ============================================
# Email Configuration (Resend)
# ============================================
# Get API key from: https://resend.com/api-keys

RESEND_API_KEY=re_your_resend_api_key

# From email address
# Production: use your verified domain (e.g., DeadManPing <alerts@yourdomain.com>)
# Development: onboarding@resend.dev (allowed by Resend)
RESEND_FROM_EMAIL=DeadManPing <onboarding@resend.dev>

# Resend receiving email address for support contact form
# Find your receiving address in Resend Dashboard -> Receiving
# Example: support@yourdomain.resend.app
RESEND_RECEIVING_EMAIL=support@yourdomain.resend.app

# ============================================
# Application Configuration
# ============================================

# Application URL (optional - auto-detected on Vercel)
# Production: https://deadmanping.com
# Development: http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://deadmanping.com

# ============================================
# Google OAuth Configuration (Optional)
# ============================================
# Get these from: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Production: https://yourdomain.com/api/auth/google/callback

# ============================================
# Security Secrets
# ============================================
# Generate with: openssl rand -hex 32
# CRITICAL: Generate strong random secrets (min 64 chars)
# NEVER commit these to git or share publicly!

JWT_SECRET=your_jwt_secret_min_64_chars_hex
INTERNAL_API_SECRET=your_random_secret_min_64_chars_hex
CRON_SECRET=your_cron_secret_min_64_chars_hex

# ============================================
# Optional: Rate Limiting (Upstash Redis)
# ============================================
# For production, use Redis-based rate limiting
# Free tier available at: https://upstash.com/

# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# ============================================
# Optional: Error Tracking (Sentry)
# ============================================
# Get DSN from: https://sentry.io/settings/deadmanping/projects/deadmanping/keys/

# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Optional: Analytics (PostHog)
# ============================================
# Get these from: https://eu.posthog.com/project/settings
# Safe to expose publicly - project API key is designed for client-side use

# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
