# ============================================
# DeadManPing - Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# PUBLIC variables (exposed to browser - safe for anon key)
# These are visible in client-side JavaScript, but that's OK:
# - Anon key is designed to be public and respects Row Level Security (RLS)
# - URL is public anyway
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# PRIVATE variable (server-side ONLY - NEVER exposed to browser)
# ⚠️ WARNING: This key bypasses RLS and has full database access!
# Only used in API routes and server-side code
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# Stripe Configuration
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (FALLBACK - only used if Products with metadata not found in Stripe)
# With new multi-currency system, prices are fetched from Stripe API automatically
# These are only used as fallback if Stripe API doesn't return prices
# 
# To use new system:
# 1. Create Products in Stripe Dashboard with metadata: plan_key = "starter" | "pro" | "team"
# 2. For each Product, create Prices in USD, EUR, PLN (monthly recurring)
# 3. System will automatically fetch prices from Stripe API
#
# Legacy/fallback Price IDs (USD only):
STRIPE_PRICE_ID_STARTER=price_xxxxx
STRIPE_PRICE_ID_PRO=price_xxxxx
STRIPE_PRICE_ID_TEAM=price_xxxxx
# Old plans (deprecated):
STRIPE_PRICE_ID_SOLO=price_xxxxx
STRIPE_PRICE_ID_AGENCY=price_xxxxx

# ============================================
# Email Configuration (Resend)
# ============================================
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# From email address (optional, defaults to onboarding@resend.dev for development)
# For production, use your verified domain: DeadManPing <alerts@yourdomain.com>
# For development, Resend allows: onboarding@resend.dev
RESEND_FROM_EMAIL=DeadManPing <onboarding@resend.dev>

# ============================================
# Application Configuration
# ============================================
# Application URL - automatically detected based on environment:
# - If set: uses this value
# - Vercel: uses VERCEL_URL automatically
# - Production: defaults to https://deadmanping.com (if not set)
# - Development: defaults to http://localhost:3000
# 
# For production, set this to your domain:
# NEXT_PUBLIC_APP_URL=https://deadmanping.com
# 
# For development, leave unset or use:
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Google OAuth Configuration
# ============================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# For production, use: https://yourdomain.com/api/auth/google/callback

# ============================================
# JWT Secret for Session Management
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_min_64_chars_hex

# ============================================
# Internal API Security
# ============================================
# ⚠️ CRITICAL: Generate strong random secrets (min 64 chars)
# Generate with: openssl rand -hex 32
# NEVER commit these to git or share publicly!
INTERNAL_API_SECRET=your_random_secret_min_64_chars_hex
CRON_SECRET=your_cron_secret_min_64_chars_hex

# ============================================
# Optional: Rate Limiting (Upstash Redis)
# ============================================
# For production, use Redis-based rate limiting
# Without Redis, rate limiting uses in-memory store (not shared across instances)
# 
# Setup:
# 1. Sign up at: https://upstash.com/
# 2. Create a new Redis database
# 3. Copy the REST URL and REST Token from the database dashboard
# 4. Add them below (uncomment and fill in)
#
# Note: Free tier available, perfect for production use
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# ============================================
# Optional: Error Tracking (Sentry)
# ============================================
# Get DSN from: https://sentry.io/settings/deadmanping/projects/deadmanping/keys/
# Use the same DSN for both (Sentry SDK handles client/server automatically)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Optional: Release version (auto-set by Vercel in production)
# NEXT_PUBLIC_SENTRY_RELEASE=commit-hash

# ============================================
# Optional: Analytics
# ============================================
# Vercel Analytics is enabled by default
# PostHog Product Analytics
# Get these from: https://eu.posthog.com/project/settings
# 
# ⚠️ Vercel Warning: This is SAFE to expose publicly!
# The PostHog project API key (phc_*) is designed to be used in client-side code.
# It's similar to Stripe publishable keys - safe for browser exposure.
# Only the project API key (not personal API keys) should be used here.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

