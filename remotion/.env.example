# ElevenLabs – do skryptu generate-vo (npm run generate-vo)
# Skopiuj do .env i wklej klucz.
ELEVENLABS_API_KEY=your_api_key_here

# Opcjonalnie: ID głosu. Nie ustawiaj = skrypt weźmie pierwszy głos z konta (wymagane na free tier).
# Głosy z biblioteki (np. Rachel) działają tylko na płatnym planie.
# ELEVENLABS_VOICE_ID=twoj_voice_id
